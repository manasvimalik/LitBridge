{
  "name": "litbridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multilingual platform translating, summarising and narrating regional Indian literature.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json && tsc -p tsconfig.scripts.json",
    "audio:direct": "tsx --env-file=.env.local scripts/audio/direct.ts",
    "audio:render": "tsx --env-file=.env.local scripts/audio/render.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
